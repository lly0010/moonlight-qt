diff --git a/src/Connection.c b/src/Connection.c
index bac9a6e..01d1fdb 100644
--- a/src/Connection.c
+++ b/src/Connection.c
@@ -29,6 +29,10 @@ uint16_t RtspPortNumber;
 uint16_t ControlPortNumber;
 uint16_t AudioPortNumber;
 uint16_t VideoPortNumber;
+uint16_t RtspPortOverride;
+uint16_t ControlPortOverride;
+uint16_t AudioPortOverride;
+uint16_t VideoPortOverride;
 SS_PING AudioPingPayload;
 SS_PING VideoPingPayload;
 uint32_t ControlConnectData;
@@ -268,8 +272,21 @@ int LiStartConnection(PSERVER_INFORMATION serverInfo, PSTREAM_CONFIGURATION stre
     ControlPortNumber = 0;
     AudioPortNumber = 0;
 
-    // Parse RTSP port number from RTSP session URL
-    if (!parseRtspPortNumberFromUrl(serverInfo->rtspSessionUrl, &RtspPortNumber)) {
+    // Capture any caller-provided port overrides. These take precedence over
+    // the well-known ports and the ports negotiated via RTSP, which allows
+    // connecting to hosts that are reachable on non-standard ports.
+    RtspPortOverride = serverInfo->rtspPortOverride;
+    VideoPortOverride = serverInfo->videoPortOverride;
+    AudioPortOverride = serverInfo->audioPortOverride;
+    ControlPortOverride = serverInfo->controlPortOverride;
+
+    // Use the RTSP port override if provided, otherwise parse it from the RTSP session URL
+    if (RtspPortOverride != 0) {
+        RtspPortNumber = RtspPortOverride;
+
+        Limelog("RTSP port: %u (overridden)\n", RtspPortNumber);
+    }
+    else if (!parseRtspPortNumberFromUrl(serverInfo->rtspSessionUrl, &RtspPortNumber)) {
         // Use the well known port if parsing fails
         RtspPortNumber = 48010;
 
